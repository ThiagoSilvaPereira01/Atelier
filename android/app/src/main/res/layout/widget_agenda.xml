<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pastel"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_agenda_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATELIER"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textColor="#B56B60"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_agenda_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda de hoje"
                android:textColor="#352421"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_agenda_date_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_pastel"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Hoje"
            android:textColor="#B56B60"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/widget_agenda_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Nenhum compromisso marcado para hoje."
        android:textColor="#9E8883"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/agenda_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_pastel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/agenda_time_1"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:text="09:00"
            android:textColor="#B56B60"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Supervisão clínica"
                android:textColor="#352421"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agenda_meta_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Supervisão"
                android:textColor="#755E59"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/agenda_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_pastel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/agenda_time_2"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:text="14:00"
            android:textColor="#B56B60"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aula de Neuropsicologia"
                android:textColor="#352421"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agenda_meta_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Faculdade"
                android:textColor="#755E59"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/agenda_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_pastel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_time_3"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:textColor="#B56B60"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#352421"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agenda_meta_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#755E59"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:id="@+id/agenda_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_pastel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_time_4"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:textColor="#B56B60"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_title_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#352421"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agenda_meta_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#755E59"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:id="@+id/agenda_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_row_pastel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/agenda_time_5"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:textColor="#B56B60"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_title_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#352421"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agenda_meta_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#755E59"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overflow footer -->
    <TextView
        android:id="@+id/widget_agenda_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#755E59"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
